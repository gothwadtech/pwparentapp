# ---------------------------------------------------------------------------
# Template configuration (web side)
# ---------------------------------------------------------------------------
# The single web app this container loads. Also used to derive the trusted
# origin for camera / microphone / geolocation grants, so it must match the
# deployment the WebView is allowed to talk to.
#
# Copy this file to .env and set the Parent App web URL.
# TODO: replace the placeholder below with the real Parent App deployment URL.
TARGET_URL=https://parent-app.example.com
